# Copiar como terraform.tfvars (está en .gitignore) y completar.
region       = "us-east-1"
project_name = "accesoseguro"
environment  = "dev"

# Versión de la imagen de la API que corre ECS (nunca latest).
api_image_tag = "v1.1"

# Notificaciones por mail con SNS (cada mail confirma la suscripción).
# Las suscripciones se activan desde la web o scripts/notificaciones.py.
notificaciones_suscriptores = {}
permiso_vigencia_segundos = 86400 # 24 horas desde aprobación
vencer_permisos_schedule = "rate(1 minute)"

# Mail que recibe las alarmas (vacío = sin suscripción).
alarm_email = ""

# RDS
db_multi_az = true

# Poner true solo si el Learner Lab deja crear trails.
enable_cloudtrail = false
